# =====================================================================
# P.I.R.E. Configuration Environment Variables (Example Template)
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# MongoDB Connection String (Default local Community Server)
# If MongoDB is not running, P.I.R.E. automatically falls back to local storage.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=pire_inventory

# Application Settings
APP_ENV=development
APP_PORT=8501
DEFAULT_LANGUAGE=en

# Model Settings
MODEL_OUTPUT_DIR=models
DEFAULT_RANDOM_SEED=42
